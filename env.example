# true = generated mock data, false = live PI Web API
VITE_USE_MOCK=true

# PI Web API base URL (no trailing slash)
VITE_PI_WEB_API_URL=https://your-pi-server/piwebapi

# Basic auth. Values are bundled into the client, so use a read-only service account
# or a proxy. Never commit the real values (.env is git-ignored).
VITE_PI_USER=
VITE_PI_PASSWORD=

# Public VAPID key for Web Push (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Asset base path. Defaults to the GitHub Pages repo path; use / for Render.
# VITE_BASE=/
